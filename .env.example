# ===== Cấu hình chung =====
PORT=3000
APP_NAME=Quản Lý Kho
BASE_URL=http://localhost:3000
SESSION_SECRET=hay-doi-chuoi-bi-mat-nay-thanh-ngau-nhien
# NODE_ENV=production   # bật khi deploy (để cookie secure/HTTPS)

# ===== Database =====
# Local: để trống -> tự dùng file db/kho.db
# Vercel/Production: điền URL + token từ Turso (https://turso.tech)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ===== Gmail (gửi email thông báo) =====
# Dùng "App Password" của Google (KHÔNG phải mật khẩu Gmail thường).
# Cách lấy: Tài khoản Google > Bảo mật > Bật 2 bước > "App passwords" (Mật khẩu ứng dụng).
# Để trống 2 dòng dưới nếu chưa muốn gửi email — app sẽ in link ra console.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ===== Google OAuth (nút "Đăng nhập bằng Google") =====
# Lấy tại: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/auth/google/callback
# Để trống nếu chưa dùng — nút Google sẽ tự ẩn.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
