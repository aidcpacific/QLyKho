<%- include('partials/header') %>

<div class="auth-wrap">
  <div class="auth-card">
    <h1>Đăng nhập</h1>
    <p class="muted">Đăng nhập bằng email hoặc tên đăng nhập.</p>

    <form action="/login" method="POST">
      <label>Email hoặc Tên đăng nhập</label>
      <input type="text" name="login" required autofocus placeholder="email@example.com hoặc username">

      <label>Mật khẩu</label>
      <input type="password" name="password" required placeholder="••••••••">

      <button class="btn btn-primary btn-block" type="submit">Đăng nhập</button>
    </form>

    <% if (googleEnabled) { %>
      <div class="divider"><span>hoặc</span></div>
      <a class="btn btn-google btn-block" href="/auth/google">
        <span class="g-logo">G</span> Đăng nhập bằng Google
      </a>
    <% } %>

    <div class="auth-links">
      <a href="/forgot">Quên mật khẩu?</a>
      <a href="/register">Tạo tài khoản mới</a>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
