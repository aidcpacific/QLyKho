<%- include('partials/header') %>

<div class="auth-wrap">
  <div class="auth-card">
    <h1>Đặt lại mật khẩu</h1>
    <p class="muted">Nhập mật khẩu mới cho tài khoản của bạn.</p>

    <form action="/reset" method="POST">
      <input type="hidden" name="token" value="<%= token %>">

      <label>Mật khẩu mới (ít nhất 6 ký tự)</label>
      <input type="password" name="password" required autofocus placeholder="••••••••">

      <label>Nhập lại mật khẩu mới</label>
      <input type="password" name="password2" required placeholder="••••••••">

      <button class="btn btn-primary btn-block" type="submit">Đặt lại mật khẩu</button>
    </form>
  </div>
</div>

<%- include('partials/footer') %>
