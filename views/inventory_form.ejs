<%- include('partials/header') %>

<% var it = item || {}; var isEdit = !!item; %>
<div class="page-head">
  <h1><%= isEdit ? 'Sửa sản phẩm' : 'Thêm sản phẩm' %></h1>
  <a class="btn btn-ghost" href="/dashboard">← Quay lại</a>
</div>

<form class="form-card" action="<%= isEdit ? '/inventory/' + it.id : '/inventory' %>" method="POST">

  <!-- ===== Nhóm 1: Thông tin sản phẩm ===== -->
  <h2 class="section-title">🏷️ Thông tin sản phẩm</h2>
  <div class="grid">
    <div class="field">
      <label>SKU (mã hàng) <span class="hint">(để trống → tự tạo theo tên + số)</span></label>
      <input type="text" id="sku" name="sku" value="<%= it.sku || '' %>" placeholder="B0XXXXXXXX">
    </div>
    <div class="field field-wide">
      <label>Tên sản phẩm *</label>
      <input type="text" name="name" required value="<%= it.name || '' %>" placeholder="Tên sản phẩm">
    </div>
    <div class="field">
      <label>Danh mục</label>
      <select name="category">
        <option value="">— Chọn danh mục —</option>
        <% (categories || []).forEach(function(c){ %>
          <option value="<%= c %>" <%= (it.category || '') === c ? 'selected' : '' %>><%= c %></option>
        <% }); %>
      </select>
    </div>
    <div class="field">
      <label>Màu sắc</label>
      <input type="text" name="color" value="<%= it.color || '' %>" placeholder="Đỏ, Đen...">
    </div>
    <div class="field">
      <label>Kích thước</label>
      <input type="text" name="size" value="<%= it.size || '' %>" placeholder="4.8 x 2.6 x 4.1 in">
    </div>
    <div class="field field-wide">
      <label>Link sản phẩm <span class="hint">(dán link → tự điền SKU + lấy giá gốc)</span></label>
      <input type="text" id="product_url" name="product_url" value="<%= it.product_url || '' %>" placeholder="https://www.amazon.com/dp/B0EB4ADQW9">
      <div id="sku-status" class="sku-status"></div>
    </div>
    <div class="field">
      <label>Giá gốc <span class="hint">(giá theo link)</span></label>
      <input type="number" step="0.01" id="original_price" name="original_price" value="<%= it.original_price != null ? it.original_price : '' %>" placeholder="0">
      <button type="button" id="btn-fetch-price" class="mini-link" style="border:none;background:none;cursor:pointer;padding:2px 0">🔗 Lấy giá từ link</button>
      <div id="price-fetch-status" class="sku-status"></div>
    </div>
    <div class="field">
      <label>Giá nhập</label>
      <input type="number" step="0.01" id="cost_price" name="cost_price" value="<%= it.cost_price != null ? it.cost_price : '' %>" placeholder="0">
    </div>
    <div class="field">
      <label>Giá bán</label>
      <input type="number" step="0.01" id="sale_price" name="sale_price" value="<%= it.sale_price != null ? it.sale_price : '' %>" placeholder="0">
    </div>
    <div class="field">
      <label>Nhà Kho</label>
      <select name="supplier_id">
        <option value="">— Chọn nhà kho —</option>
        <% (suppliers || []).forEach(function(s){ %>
          <option value="<%= s.id %>" <%= it.supplier_id == s.id ? 'selected' : '' %>><%= s.name %></option>
        <% }); %>
      </select>
      <a href="/nha-cung-cap" target="_blank" class="mini-link">+ Thêm nhà kho</a>
    </div>
    <!-- Gợi ý giá tối ưu (tự tính khi nhập giá nhập + giá bán) -->
    <div class="field field-wide">
      <div id="price-helper" class="price-helper">Nhập <b>Giá nhập</b> và <b>Giá bán</b> để xem lợi nhuận & gợi ý giá tối ưu.</div>
    </div>
  </div>

  <!-- ===== Nhóm 2: Tồn kho ===== -->
  <h2 class="section-title">📦 Tồn kho</h2>
  <div class="grid">
    <div class="field">
      <label>Số lượng hiện có</label>
      <input type="number" id="qty" name="quantity" min="0" value="<%= it.quantity != null ? it.quantity : 0 %>">
    </div>
    <div class="field">
      <label>Số lượng đã đặt hàng <span class="hint">(đang về)</span></label>
      <input type="number" id="onorder" name="on_order" min="0" value="<%= it.on_order != null ? it.on_order : 0 %>">
    </div>
    <div class="field">
      <label>Số lượng khả dụng <span class="hint">(tự tính = hiện có + đã đặt)</span></label>
      <input type="number" id="available" value="0" readonly class="readonly">
    </div>
    <div class="field">
      <label>Tồn tối thiểu <span class="hint">(cảnh báo khi ≤ mức này)</span></label>
      <input type="number" name="min_quantity" min="0" value="<%= it.min_quantity != null ? it.min_quantity : 0 %>" placeholder="0 = tắt">
    </div>
    <div class="field">
      <label>Tồn tối đa</label>
      <input type="number" name="max_quantity" min="0" value="<%= it.max_quantity != null ? it.max_quantity : 0 %>" placeholder="0 = không giới hạn">
    </div>
  </div>

  <!-- ===== Nhóm 3: Vận chuyển / Nhập hàng ===== -->
  <h2 class="section-title">🚚 Vận chuyển / Nhập hàng</h2>
  <div class="grid">
    <div class="field">
      <label>Inbound ID</label>
      <input type="text" name="inbound_id" value="<%= it.inbound_id || '' %>" placeholder="Tự sinh nếu trống">
    </div>
    <div class="field">
      <label>Date</label>
      <input type="text" name="date" value="<%= it.date || '' %>" placeholder="2026-06-02">
    </div>
    <div class="field">
      <label>Trọng lượng</label>
      <input type="text" name="weight" value="<%= it.weight || '' %>" placeholder="1.88 lbs">
    </div>
    <div class="field">
      <label>Tracking number</label>
      <input type="text" name="tracking" value="<%= it.tracking || '' %>" placeholder="9200...">
    </div>
    <div class="field">
      <label>Đơn vị vận chuyển</label>
      <input type="text" name="carrier" value="<%= it.carrier || '' %>" placeholder="USPS, GHN, GHTK...">
    </div>
    <div class="field">
      <label>Ngày đến dự kiến</label>
      <input type="text" name="eta" value="<%= it.eta || '' %>" placeholder="2026-06-06">
    </div>
    <div class="field">
      <label>Trạng thái</label>
      <select name="status">
        <% (statuses || []).forEach(function(st){ %>
          <option value="<%= st %>" <%= (it.status || 'Chờ xử lý') === st ? 'selected' : '' %>><%= st %></option>
        <% }); %>
      </select>
    </div>
    <div class="field field-wide">
      <label>Địa chỉ (Add) <span class="hint">(địa chỉ giao/nhận)</span></label>
      <textarea name="address" rows="2" placeholder="Tên, đường, thành phố, mã ZIP..."><%= it.address || '' %></textarea>
    </div>
    <div class="field field-wide">
      <label>Hình ảnh sản phẩm (URL)</label>
      <input type="text" name="image_url" value="<%= it.image_url || '' %>" placeholder="https://...">
    </div>
  </div>

  <button class="btn btn-primary" type="submit"><%= isEdit ? 'Lưu thay đổi' : 'Thêm sản phẩm' %></button>
</form>

<script>
(function () {
  // 1) Tự tính khả dụng = hiện có + đã đặt
  var qty = document.getElementById('qty');
  var onorder = document.getElementById('onorder');
  var avail = document.getElementById('available');
  function calcAvail() {
    var a = (parseInt(qty.value, 10) || 0) + (parseInt(onorder.value, 10) || 0);
    avail.value = a;
  }
  qty.addEventListener('input', calcAvail);
  onorder.addEventListener('input', calcAvail);
  calcAvail();

  // 2) Tự bóc SKU (ASIN) từ link sản phẩm
  var urlInput = document.getElementById('product_url');
  var skuInput = document.getElementById('sku');
  var status = document.getElementById('sku-status');
  function extractSku(u) {
    if (!u) return '';
    var m = u.match(/(?:\/dp\/|\/gp\/product\/|\/product\/|\/ASIN\/|[?&]asin=)([A-Z0-9]{10})/i);
    if (m) return m[1].toUpperCase();
    var b = u.match(/\b(B0[A-Z0-9]{8})\b/i);
    if (b) return b[1].toUpperCase();
    return '';
  }
  function fill() {
    var sku = extractSku(urlInput.value.trim());
    if (sku) {
      if (!skuInput.value.trim()) {
        skuInput.value = sku;
        status.textContent = '✓ Đã tự điền SKU: ' + sku;
        status.className = 'sku-status ok';
      } else {
        status.textContent = 'Tìm thấy SKU ' + sku + ' (ô SKU đã có sẵn, không ghi đè).';
        status.className = 'sku-status';
      }
    } else if (urlInput.value.trim()) {
      status.textContent = 'Link không có mã SKU — nếu để trống, hệ thống sẽ tự tạo SKU theo tên sản phẩm.';
      status.className = 'sku-status warn';
    } else { status.textContent = ''; }
  }
  urlInput.addEventListener('input', fill);
  urlInput.addEventListener('paste', function () { setTimeout(fill, 50); });

  // 2b) Lấy giá gốc từ link sản phẩm
  var origEl = document.getElementById('original_price');
  var priceStatus = document.getElementById('price-fetch-status');
  var btnFetch = document.getElementById('btn-fetch-price');
  function fetchPrice(force) {
    var url = urlInput.value.trim();
    if (!/^https?:\/\//i.test(url)) { if (force) { priceStatus.textContent = 'Dán link hợp lệ trước (bắt đầu bằng http).'; priceStatus.className = 'sku-status warn'; } return; }
    if (!force && origEl.value.trim()) return; // không ghi đè nếu đã có
    priceStatus.textContent = '⏳ Đang lấy giá từ link...';
    priceStatus.className = 'sku-status';
    fetch('/api/fetch-price', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ url: url })
    }).then(function (r) { return r.json(); }).then(function (d) {
      if (d && d.ok && d.price) {
        origEl.value = d.price;
        priceStatus.textContent = '✓ Giá gốc lấy được: ' + Number(d.price).toLocaleString('vi-VN');
        priceStatus.className = 'sku-status ok';
        if (typeof calcPrice === 'function') calcPrice();
      } else {
        priceStatus.textContent = '✗ Không lấy được giá tự động (trang chặn hoặc không có giá). Hãy nhập tay.';
        priceStatus.className = 'sku-status warn';
      }
    }).catch(function () {
      priceStatus.textContent = '✗ Lỗi khi lấy giá. Hãy nhập tay.';
      priceStatus.className = 'sku-status warn';
    });
  }
  urlInput.addEventListener('change', function () { fetchPrice(false); });
  if (btnFetch) btnFetch.addEventListener('click', function () { fetchPrice(true); });

  // 3) Gợi ý giá tối ưu khi nhập giá nhập + giá bán
  var costEl = document.getElementById('cost_price');
  var saleEl = document.getElementById('sale_price');
  var helper = document.getElementById('price-helper');
  function fmt(n) { return Math.round(n).toLocaleString('vi-VN'); }
  function calcPrice() {
    var cost = parseFloat(costEl.value) || 0;
    var sale = parseFloat(saleEl.value) || 0;
    if (cost <= 0) {
      helper.className = 'price-helper';
      helper.innerHTML = 'Nhập <b>Giá nhập</b> và <b>Giá bán</b> để xem lợi nhuận & gợi ý giá tối ưu.';
      return;
    }
    // Gợi ý giá bán để đạt biên lợi nhuận mục tiêu: giá = giá nhập / (1 - margin)
    var s20 = cost / (1 - 0.20), s30 = cost / (1 - 0.30), s40 = cost / (1 - 0.40);
    var html = '<div class="ph-suggest">💡 Gợi ý giá bán tối ưu (theo biên lợi nhuận): '
      + '<span class="ph-chip" data-v="' + Math.round(s20) + '">20% → ' + fmt(s20) + '</span>'
      + '<span class="ph-chip" data-v="' + Math.round(s30) + '">30% → ' + fmt(s30) + '</span>'
      + '<span class="ph-chip" data-v="' + Math.round(s40) + '">40% → ' + fmt(s40) + '</span></div>';

    if (sale > 0) {
      var profit = sale - cost;
      var margin = sale > 0 ? (profit / sale * 100) : 0;
      var markup = cost > 0 ? (profit / cost * 100) : 0;
      var cls = profit < 0 ? 'loss' : (margin < 10 ? 'low' : 'good');
      var msg = profit < 0 ? '⚠ ĐANG LỖ' : (margin < 10 ? '⚠ Lãi mỏng' : '✓ Tốt');
      html = '<div class="ph-stat ' + cls + '">'
        + '<span>Lợi nhuận/cái: <b>' + fmt(profit) + '</b></span>'
        + '<span>Biên LN: <b>' + margin.toFixed(1) + '%</b></span>'
        + '<span>Markup: <b>' + markup.toFixed(1) + '%</b></span>'
        + '<span class="ph-tag">' + msg + '</span></div>' + html;
    }
    helper.className = 'price-helper active';
    helper.innerHTML = html;
    // Bấm vào chip để điền nhanh giá bán gợi ý
    helper.querySelectorAll('.ph-chip').forEach(function (chip) {
      chip.addEventListener('click', function () { saleEl.value = chip.getAttribute('data-v'); calcPrice(); });
    });
  }
  costEl.addEventListener('input', calcPrice);
  saleEl.addEventListener('input', calcPrice);
  calcPrice();
})();
</script>

<%- include('partials/footer') %>
