<%- include('partials/header') %>

<div class="page-head">
  <h1>🏬 Nhà Kho</h1>
  <a class="btn btn-ghost" href="/dashboard">← Về quản lý kho</a>
</div>

<div class="two-col">
  <div class="panel">
    <h2>Thêm nhà kho</h2>
    <form action="/nha-cung-cap" method="POST">
      <label>Tên nhà kho *</label>
      <input type="text" name="name" required placeholder="VD: Kho Thornton">
      <label>Địa chỉ</label>
      <input type="text" name="address" placeholder="VD: 4392 E 126pl, Thornton, CO 80241">
      <label>Email</label>
      <input type="email" name="email" placeholder="(tùy chọn)">
      <label>Số điện thoại</label>
      <input type="text" name="phone" placeholder="(tùy chọn)">
      <label>Ghi chú</label>
      <input type="text" name="note" placeholder="(tùy chọn)">
      <button class="btn btn-primary btn-block" type="submit">Thêm nhà kho</button>
    </form>
  </div>

  <div class="panel">
    <h2>Danh sách nhà kho (<%= suppliers.length %>)</h2>
    <table class="mini-table">
      <thead><tr><th>Tên nhà kho / Địa chỉ</th><th>Email</th><th>Điện thoại</th><th>Ghi chú</th><th>Tổng SP</th><th></th></tr></thead>
      <tbody>
        <% if (suppliers.length === 0) { %><tr><td colspan="6" class="empty">Chưa có nhà kho nào.</td></tr><% } %>
        <% suppliers.forEach(function(s){ %>
          <tr>
            <td><b><%= s.name %></b><% if (s.address) { %><br><span class="muted" style="font-size:11px"><%= s.address %></span><% } %></td>
            <td><%= s.email || '' %></td>
            <td><%= s.phone || '' %></td>
            <td><%= s.note || '' %></td>
            <td><span class="cat-badge"><%= s.product_count %> SP</span></td>
            <td class="row-actions">
              <a href="#" class="link" onclick="document.getElementById('edit-<%= s.id %>').style.display='table-row';return false">Sửa</a>
              <% if (user.role === 'admin') { %>
                <form action="/nha-cung-cap/<%= s.id %>/delete" method="POST" onsubmit="return confirm('Xóa nhà kho \'<%= s.name %>\'?')" style="display:inline">
                  <button type="submit" class="link link-danger">Xóa</button>
                </form>
              <% } %>
            </td>
          </tr>
          <tr id="edit-<%= s.id %>" style="display:none">
            <td colspan="6">
              <form action="/nha-cung-cap/<%= s.id %>" method="POST" class="edit-row">
                <input type="text" name="name" value="<%= s.name %>" placeholder="Tên nhà kho" required>
                <input type="text" name="address" value="<%= s.address || '' %>" placeholder="Địa chỉ">
                <input type="email" name="email" value="<%= s.email || '' %>" placeholder="Email">
                <input type="text" name="phone" value="<%= s.phone || '' %>" placeholder="Điện thoại">
                <input type="text" name="note" value="<%= s.note || '' %>" placeholder="Ghi chú">
                <button type="submit" class="btn btn-sm btn-primary">Lưu</button>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/footer') %>
